<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup><OutputType>Exe</OutputType><TargetFramework>net10.0-windows</TargetFramework><PlatformTarget>x64</PlatformTarget><LangVersion>14.0</LangVersion><Nullable>enable</Nullable><ImplicitUsings>enable</ImplicitUsings><AllowUnsafeBlocks>true</AllowUnsafeBlocks><GenerateAssemblyInfo>false</GenerateAssemblyInfo><EnableDefaultCompileItems>false</EnableDefaultCompileItems><StartupObject>CoreRequestDiagnosticRegression.Program</StartupObject></PropertyGroup>
  <ItemGroup>
    <Reference Include="System.ServiceProcess.ServiceController"><HintPath>$(MSBuildToolsPath)/System.ServiceProcess.ServiceController.dll</HintPath><Private>true</Private></Reference>
    <Reference Include="System.Diagnostics.EventLog"><HintPath>$(MSBuildToolsPath)/System.Diagnostics.EventLog.dll</HintPath><Private>true</Private></Reference>
    <Compile Include="../../src/service/**/*.cs" Exclude="../../src/service/obj/**/*.cs;../../src/service/bin/**/*.cs" />
    <Compile Include="Program.cs" />
  </ItemGroup>
</Project>
