<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType><TargetFramework>net10.0-windows</TargetFramework><PlatformTarget>x64</PlatformTarget>
    <LangVersion>14.0</LangVersion><Nullable>enable</Nullable><ImplicitUsings>enable</ImplicitUsings>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks><GenerateAssemblyInfo>false</GenerateAssemblyInfo><EnableDefaultCompileItems>false</EnableDefaultCompileItems>
    <StartupObject>CoreDnsFastRecoveryRegression.Program</StartupObject>
    <ControllerSource Condition="'$(ControllerSource)' == ''">../../src/service/EgoistShield.Service/OwnedServiceController.cs</ControllerSource>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="System.ServiceProcess.ServiceController" Version="10.0.0" />
    <Compile Include="../../src/service/**/*.cs" Exclude="../../src/service/obj/**/*.cs;../../src/service/bin/**/*.cs;../../src/service/EgoistShield.Service/OwnedServiceController.cs" />
    <Compile Include="$(ControllerSource)" Link="OwnedServiceController.cs" />
    <Compile Include="Program.cs" />
  </ItemGroup>
</Project>
