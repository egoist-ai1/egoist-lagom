      <WorkingDirectory>C:\ProgramData\EgoistShieldInstaller\DeferredRuns\aaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaa</WorkingDirectory>
    </Exec>
  </Actions>
</Task>